{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage Box",
  "mainBinaryName": "vantage-box",
  "version": "0.1.0",
  "identifier": "dev.vantagebox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vantage Box",
        "width": 1040,
        "height": 720,
        "minWidth": 640,
        "minHeight": 440,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/noartem/vantage-box/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RjMxNTI4MDM1REE1NzgKUldSNHBWMERLQlh6VmxtQ3NpdDZ6QkFDTVpoSXRpRHJiaU45ODRmRGVoYkw2VXgzRWhtMis3aVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vantage Box",
    "shortDescription": "GUI для sing-box",
    "longDescription": "Минималистичный десктопный интерфейс для sing-box: управление рантаймом через Clash API, переключение selector-групп, логи и редактор конфига.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
